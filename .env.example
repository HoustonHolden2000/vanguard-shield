# Iron Halo Verify v4.1 environment variables
# Copy to .env (locally) or configure in Render dashboard (production).
# NEVER commit .env to GitHub - it's gitignored.

# JWT secrets - generate fresh random hex (e.g. `openssl rand -hex 64`)
JWT_SECRET=replace_with_64_byte_random_hex
JWT_REFRESH_SECRET=replace_with_different_64_byte_random_hex

# Database path - on Render, point to persistent disk mount
DB_PATH=./data2/shield.db

# Server config
PORT=3000
NODE_ENV=production

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=https://vanguard-shield.onrender.com

# Admin bootstrap - one-time use to create first admin user
# Set, run server once, change admin password through admin UI, then remove this var
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace_with_strong_temp_password
