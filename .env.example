# Iron Halo Verify / Vanguard Shield v4.2 environment variables
# Copy to .env (locally) or configure in Render dashboard (production).
# NEVER commit .env to GitHub - it's gitignored.

# --- Auth (REQUIRED, fail-fast on boot) -------------------------------------
# Generate fresh random hex per environment: `openssl rand -hex 64`
# Must be at least 32 chars and JWT_SECRET must differ from JWT_REFRESH_SECRET.
JWT_SECRET=replace_with_64_byte_random_hex
JWT_REFRESH_SECRET=replace_with_different_64_byte_random_hex

# --- Database ---------------------------------------------------------------
# On Render, point to persistent disk mount.
DB_PATH=./data2/shield.db

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=production

# CORS - comma-separated list of allowed origins. Empty = allow all (dev only).
ALLOWED_ORIGINS=https://vanguard-shield.onrender.com

# --- One-time bootstrap -----------------------------------------------------
# Set, run server once, change admin password through admin UI, then REMOVE.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace_with_strong_temp_password

# Optional: bootstrap a default guard at the demo_site for pilot deployments.
GUARD_BOOTSTRAP_USERNAME=
GUARD_BOOTSTRAP_PASSWORD=

# --- Vanguard Shield Intelligence Layer (OpenAI) ----------------------------
# Endpoint /api/intel/summarize is admin-only. It sends ONLY scan-tape
# aggregates + hashed payload metadata to OpenAI. No PII, no photos, no
# raw payload strings. Endpoint returns 503 unless both vars are set.
OPENAI_INTEL_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
